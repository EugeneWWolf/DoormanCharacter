<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Configurations>Release;Debug</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove=".gitignore" />
    <None Remove="nuget.config" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="BepInEx.Analyzers" Version="1.0.8">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="BepInEx.Core" Version="5.4.21" />
		<PackageReference Include="UnityEngine.Modules" Version="2021.3.45" />
		<PackageReference Include="RiskOfRain2.GameLibs" Version="1.5.0-r.1" />
		<PackageReference Include="MMHOOK.RoR2" Version="2026.10.8" NoWarn="NU1701" />
		<PackageReference Include="RoR2BepInExPack" Version="1.49.0" />
		
		<PackageReference Include="R2API.Core" Version="5.3.0" />
		<PackageReference Include="R2API.Prefab" Version="1.1.1" />
		<PackageReference Include="R2API.RecalculateStats" Version="1.7.0" />
		<PackageReference Include="R2API.Language" Version="1.1.0" />
		<PackageReference Include="R2API.Sound" Version="1.0.3" />
	</ItemGroup>

	<ItemGroup>
	  <Reference Include="ExtraSkillSlots">
	    <HintPath>C:\Users\user\AppData\Roaming\r2modmanPlus-local\RiskOfRain2\profiles\doormanmandavoshka\BepInEx\plugins\KingEnderBrine-ExtraSkillSlots\ExtraSkillSlots\ExtraSkillSlots.dll</HintPath>
	  </Reference>
	</ItemGroup>

  <Target Name="StageMod" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)/../Build/plugins" />
    <Copy Condition="Exists('$(MSBuildProjectDirectory)/../HenryUnityProject/AssetBundles/doormanbundle')" SourceFiles="$(MSBuildProjectDirectory)/../HenryUnityProject/AssetBundles/doormanbundle" DestinationFolder="$(MSBuildProjectDirectory)/../Build/plugins/AssetBundles" />
  </Target>
</Project>
